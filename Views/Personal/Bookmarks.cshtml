@model Library.Models.PagedResult<Library.Models.Bookmark>

@{
    ViewData["Title"] = "Мои закладки";
}

<div class="container">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2><i class="fas fa-bookmark me-2"></i>Мои закладки</h2>
            </div>
            
            <div class="alert alert-info">
                <i class="fas fa-info-circle me-2"></i>
                <strong>Мои закладки</strong> - здесь хранятся все ваши закладки из прочитанных книг. 
                Вы можете добавлять, редактировать и удалять закладки.
            </div>
        </div>
    </div>

    @if (Model.Items.Any())
    {
        <div class="row">
            @foreach (var bookmark in Model.Items)
            {
                <div class="col-lg-6 mb-4">
                    <div class="card h-100 bookmark-card fade-in-up">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <h5 class="card-title">@bookmark.Title</h5>
                                <div class="dropdown">
                                    <button class="btn btn-outline-secondary btn-sm dropdown-toggle" type="button" data-bs-toggle="dropdown">
                                        <i class="fas fa-ellipsis-v"></i>
                                    </button>
                                    <ul class="dropdown-menu">
                                        <li><a class="dropdown-item" href="@Url.Action("EditBookmark", new { id = bookmark.Id })">
                                            <i class="fas fa-edit me-2"></i>Редактировать
                                        </a></li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li><a class="dropdown-item text-danger" href="#" onclick="deleteBookmark(@bookmark.Id)">
                                            <i class="fas fa-trash me-2"></i>Удалить
                                        </a></li>
                                    </ul>
                                </div>
                            </div>
                            
                            <p class="text-muted mb-2">
                                <i class="fas fa-book me-1"></i>@bookmark.Book.Title
                            </p>
                            
                            <p class="text-muted mb-2">
                                <i class="fas fa-user me-1"></i>@bookmark.Book.Author.FullName
                            </p>
                            
                            @if (bookmark.PageNumber.HasValue)
                            {
                                <p class="text-muted small mb-2">
                                    <i class="fas fa-file-alt me-1"></i>Страница: @bookmark.PageNumber
                                </p>
                            }
                            
                            @if (!string.IsNullOrEmpty(bookmark.Description))
                            {
                                <p class="text-muted small mb-2">@bookmark.Description</p>
                            }
                            
                            @if (!string.IsNullOrEmpty(bookmark.Quote))
                            {
                                <div class="alert alert-light">
                                    <small><strong>Цитата:</strong> "@bookmark.Quote"</small>
                                </div>
                            }
                            
                            <div class="d-flex justify-content-between align-items-center">
                                <small class="text-muted">
                                    <i class="fas fa-calendar me-1"></i>@bookmark.CreatedDate.ToString("dd.MM.yyyy")
                                </small>
                                <div>
                                    <a href="@Url.Action("Details", "Books", new { id = bookmark.Book.Id })" class="btn btn-outline-primary btn-sm me-2">
                                        <i class="fas fa-eye me-1"></i>О книге
                                    </a>
                                    <a href="@Url.Action("Read", "Reading", new { id = bookmark.Book.Id })" class="btn btn-primary btn-sm">
                                        <i class="fas fa-book-open me-1"></i>Читать
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <i class="fas fa-bookmark fa-5x text-muted mb-3"></i>
            <h4 class="text-muted">Закладок пока нет</h4>
            <p class="text-muted">Добавляйте закладки во время чтения книг</p>
            <a href="@Url.Action("Index", "Books")" class="btn btn-primary">
                <i class="fas fa-book me-1"></i>Перейти к каталогу
            </a>
        </div>
    }

    <!-- Пагинация -->
    @if (Model.TotalPages > 1)
    {
        <div class="mt-5 mb-4 px-3">
            <nav aria-label="Пагинация закладок">
                <ul class="pagination justify-content-center">
                @if (Model.HasPreviousPage)
                {
                    <li class="page-item">
                        <a class="page-link" href="@Url.Action("Bookmarks", new { page = Model.PageNumber - 1 })">
                            <i class="fas fa-chevron-left"></i> Предыдущая
                        </a>
                    </li>
                }

                @for (int i = Model.StartPage; i <= Model.EndPage; i++)
                {
                    <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                        <a class="page-link" href="@Url.Action("Bookmarks", new { page = i })">@i</a>
                    </li>
                }

                @if (Model.HasNextPage)
                {
                    <li class="page-item">
                        <a class="page-link" href="@Url.Action("Bookmarks", new { page = Model.PageNumber + 1 })">
                            Следующая <i class="fas fa-chevron-right"></i>
                        </a>
                    </li>
                }
                </ul>
            </nav>

            <div class="text-center text-muted mt-3">
                <small>
                    Показано @((Model.PageNumber - 1) * Model.PageSize + 1) - @(Math.Min(Model.PageNumber * Model.PageSize, Model.TotalCount)) 
                    из @Model.TotalCount закладок
                </small>
            </div>
        </div>
    }
</div>

<script>
    function deleteBookmark(bookmarkId) {
        if (confirm('Вы уверены, что хотите удалить эту закладку?')) {
            fetch('@Url.Action("DeleteBookmark")', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                },
                body: JSON.stringify({ bookmarkId: bookmarkId })
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    location.reload();
                } else {
                    alert('Ошибка при удалении закладки');
                }
            });
        }
    }
</script>
