@model Library.Models.Bookmark

@{
    ViewData["Title"] = "Редактировать закладку";
}

<div class="container">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2><i class="fas fa-edit me-2"></i>Редактировать закладку</h2>
                <a href="@Url.Action("Bookmarks")" class="btn btn-outline-secondary">
                    <i class="fas fa-arrow-left me-1"></i>Назад к закладкам
                </a>
            </div>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">@Model.Book.Title</h5>
                    <p class="text-muted mb-0">@Model.Book.Author.FullName</p>
                </div>
                <div class="card-body">
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    <form asp-action="EditBookmark" method="post">
                        <input asp-for="Id" type="hidden" />
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        
                        <div class="mb-3">
                            <label asp-for="Title" class="form-label">Название закладки *</label>
                            <input asp-for="Title" class="form-control" />
                            <span asp-validation-for="Title" class="text-danger"></span>
                        </div>
                        
                        <div class="mb-3">
                            <label asp-for="Description" class="form-label">Описание</label>
                            <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>
                        
                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="PageNumber" class="form-label">Номер страницы</label>
                                    <input asp-for="PageNumber" class="form-control" type="number" min="1" />
                                    <span asp-validation-for="PageNumber" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label class="form-label">Дата создания</label>
                                    <input value="@Model.CreatedDate.ToString("dd.MM.yyyy HH:mm")" class="form-control" readonly />
                                </div>
                            </div>
                        </div>
                        
                        <div class="mb-3">
                            <label asp-for="Quote" class="form-label">Цитата</label>
                            <textarea asp-for="Quote" class="form-control" rows="3" placeholder="Введите цитату из книги..."></textarea>
                            <span asp-validation-for="Quote" class="text-danger"></span>
                        </div>
                        
                        <div class="d-flex justify-content-between">
                            <a href="@Url.Action("Bookmarks")" class="btn btn-secondary">
                                <i class="fas fa-arrow-left me-1"></i>Отмена
                            </a>
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-save me-1"></i>Сохранить изменения
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}



