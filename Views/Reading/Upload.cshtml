@model Library.Models.Book

@{
    ViewData["Title"] = "Загрузить файл книги";
}

<div class="container">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2><i class="fas fa-upload me-2"></i>Загрузить файл книги</h2>
                <a asp-controller="Books" asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">
                    <i class="fas fa-arrow-left me-1"></i>Назад к книге
                </a>
            </div>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header">
                    <h4 class="mb-0">@Model.Title</h4>
                    <p class="text-muted mb-0">@Model.Author.FullName</p>
                </div>
                <div class="card-body">
                    @if (!string.IsNullOrEmpty(Model.FileName))
                    {
                        <div class="alert alert-info">
                            <i class="fas fa-info-circle me-2"></i>
                            <strong>Текущий файл:</strong> @Model.FileName 
                            (@(Model.FileSize.HasValue ? $"{Model.FileSize.Value / 1024 / 1024} MB" : "Неизвестный размер"))
                            <br>
                            <small>Загрузка нового файла заменит существующий.</small>
                        </div>
                    }

                    <form asp-action="Upload" method="post" enctype="multipart/form-data">
                        <input asp-for="Id" type="hidden" />
                        
                        <div class="mb-4">
                            <label for="file" class="form-label">Выберите файл книги *</label>
                            <input type="file" name="file" id="file" class="form-control" accept=".pdf,.epub,.txt,.doc,.docx,.rtf" required />
                            <div class="form-text">
                                Поддерживаемые форматы: PDF, EPUB, TXT, DOC, DOCX, RTF (максимум 50MB)
                            </div>
                        </div>

                        <div class="mb-3">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="replaceFile" name="replaceFile" value="true" />
                                <label class="form-check-label" for="replaceFile">
                                    Заменить существующий файл
                                </label>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between">
                            <a asp-controller="Books" asp-action="Details" asp-route-id="@Model.Id" class="btn btn-secondary">
                                Отмена
                            </a>
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-upload me-1"></i>Загрузить файл
                            </button>
                        </div>
                    </form>

                    @if (!string.IsNullOrEmpty(Model.FileName))
                    {
                        <hr>
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6>Управление файлом</h6>
                                <p class="text-muted small mb-0">
                                    Файл: @Model.FileName<br>
                                    Размер: @(Model.FileSize.HasValue ? $"{Model.FileSize.Value / 1024 / 1024} MB" : "Неизвестно")
                                </p>
                            </div>
                            <div>
                                <form asp-action="DeleteFile" method="post" class="d-inline">
                                    <input asp-for="Id" type="hidden" />
                                    <button type="submit" class="btn btn-outline-danger btn-sm" 
                                            onclick="return confirm('Вы уверены, что хотите удалить файл книги?')">
                                        <i class="fas fa-trash me-1"></i>Удалить файл
                                    </button>
                                </form>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    document.getElementById('file').addEventListener('change', function(e) {
        const file = e.target.files[0];
        if (file) {
            const fileSize = file.size / 1024 / 1024; // MB
            if (fileSize > 50) {
                alert('Размер файла превышает 50MB. Пожалуйста, выберите файл меньшего размера.');
                e.target.value = '';
                return;
            }
            
            const allowedTypes = ['application/pdf', 'application/epub+zip', 'text/plain', 
                                 'application/msword', 'application/vnd.openxmlformats-officedocument.wordprocessingml.document', 
                                 'application/rtf'];
            
            if (!allowedTypes.includes(file.type)) {
                alert('Неподдерживаемый тип файла. Пожалуйста, выберите файл в поддерживаемом формате.');
                e.target.value = '';
                return;
            }
        }
    });
</script>



