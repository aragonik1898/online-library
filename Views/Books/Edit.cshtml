@model Library.Models.Book

@{
    ViewData["Title"] = "Редактировать книгу";
}

<div class="container">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2><i class="fas fa-edit me-2"></i>Редактировать книгу</h2>
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="fas fa-arrow-left me-1"></i>Назад к каталогу
                </a>
            </div>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card">
                <div class="card-body">
                    <form asp-action="Edit" method="post">
                        <input asp-for="Id" type="hidden" />
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        
                        <div class="mb-3">
                            <label asp-for="Title" class="form-label">Название книги *</label>
                            <input asp-for="Title" class="form-control" />
                            <span asp-validation-for="Title" class="text-danger"></span>
                        </div>
                        
                        <div class="mb-3">
                            <label asp-for="Description" class="form-label">Описание</label>
                            <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>
                        
                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="ISBN" class="form-label">ISBN *</label>
                                    <input asp-for="ISBN" class="form-control" />
                                    <span asp-validation-for="ISBN" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="PublicationYear" class="form-label">Год издания *</label>
                                    <input asp-for="PublicationYear" class="form-control" type="number" min="1000" max="2025" />
                                    <span asp-validation-for="PublicationYear" class="text-danger"></span>
                                </div>
                            </div>
                        </div>
                        
                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="Publisher" class="form-label">Издательство</label>
                                    <input asp-for="Publisher" class="form-control" />
                                    <span asp-validation-for="Publisher" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="PageCount" class="form-label">Количество страниц *</label>
                                    <input asp-for="PageCount" class="form-control" type="number" min="1" />
                                    <span asp-validation-for="PageCount" class="text-danger"></span>
                                </div>
                            </div>
                        </div>
                        
                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="AuthorId" class="form-label">Автор *</label>
                                    <select asp-for="AuthorId" class="form-select" asp-items="@(new SelectList(ViewBag.Authors, "Id", "FullName"))">
                                        <option value="">Выберите автора</option>
                                    </select>
                                    <span asp-validation-for="AuthorId" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="GenreId" class="form-label">Жанр *</label>
                                    <select asp-for="GenreId" class="form-select" asp-items="@(new SelectList(ViewBag.Genres, "Id", "Name"))">
                                        <option value="">Выберите жанр</option>
                                    </select>
                                    <span asp-validation-for="GenreId" class="text-danger"></span>
                                </div>
                            </div>
                        </div>
                        
                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="CoverImageUrl" class="form-label">URL обложки</label>
                                    <input asp-for="CoverImageUrl" class="form-control" type="url" />
                                    <span asp-validation-for="CoverImageUrl" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="FileUrl" class="form-label">URL файла книги</label>
                                    <input asp-for="FileUrl" class="form-control" type="url" />
                                    <span asp-validation-for="FileUrl" class="text-danger"></span>
                                </div>
                            </div>
                        </div>
                        
                        <div class="mb-3 form-check">
                            <input asp-for="IsAvailable" class="form-check-input" />
                            <label asp-for="IsAvailable" class="form-check-label">
                                Книга доступна
                            </label>
                        </div>
                        
                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-secondary">Отмена</a>
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-save me-1"></i>Сохранить изменения
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}



